<div class="home-page">
  <div class="flou-gradient">
    <div class="top">
      <div class="logo">
        <%= image_tag "couronne-du-roi-dorée.png", alt: "logo repertoria couronne du roi dorée", class: "logo-icon navbar-logo-img" %>
          <div class="top-title">
            <h1>Repertoria</h1>
            <p>RÉPERTOIRE D'OUVERTURES</p>
          </div>
      </div>
    </div>

    <p class="tagline">Le coach d'ouverture pour joueurs d'échecs débutants</p>

    <div class="separator"></div>

    <p class="quote">« Ne jouez plus au hasard. Jouez aux échecs. »</p>

    <div class="separator"></div>

    <div class="bottom">
      <form action="/analyse" method="get">
        <input type="text" name="username" placeholder="Votre pseudo Chess.com">
        <button>Analyser mon répertoire</button>
      </form>
    </div>
  </div>
</div>
