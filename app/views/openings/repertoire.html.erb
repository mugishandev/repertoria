<% content_for(:page_title, "Mon répertoire") %>
<div class="repertory-container">
  <div class="repertory-openings">
    <div class="repertory-openings-title">
      <h2>Mes ouvertures</h2>
      <p>Sélectionne une ouverture pour afficher tes statistiques affiliées.</p>
    </div>
    <div>
      <section class="opening repertory-openings-cards">
        <div class="repertory-opening-card">
          <div class="repertory-card-top">
            <%= image_tag "knight_bleu", alt: "icone ouverture blancs", class: "repertory-card-logo" %>
            <div class="repertory-card-title">
              <p> Avec les Blancs </p>
              <h5><%= @analysis["white"]["opening_recommended"] %></h5>
            </div>
          </div>
          <div class="repertory-opening-desc">
            <h3 class="opening-title">
            </h3>
            <p class="move-list">
              <%= @analysis["white"]["suite_de_coups"] %>
            </p>
            <%= link_to "", repertoire_white_path(@opening),
            # class: "link #{'active' if current_page?(white_opening_path(@opening)) || current_page?(opening_path(@opening))}",
            data: { turbo_frame: "opening_color_content", turbo_action: "advance" }, class: "opening-link" %>
          </div>
        </div>
        <div class="repertory-opening-card">
          <div class="repertory-card-top">
            <%= image_tag "pawn_bleu", alt: "icone ouverture blancs", class: "repertory-card-logo" %>
            <div class="repertory-card-title">
              <p> Avec les Noirs contre 1.d4 </p>
              <h5><%= @analysis["black_vs_d4"]["opening_recommended"] %></h5>
            </div>
          </div>
          <div class="repertory-opening-desc">
            <h3 class="opening-title">
            </h3>
            <p class="move-list">
              <%= @analysis["black_vs_d4"]["suite_de_coups"] %>
            </p>
            <%= link_to "", repertoire_black_vs_d4_path(@opening),
            # class: "link #{'active' if current_page?(white_opening_path(@opening)) || current_page?(opening_path(@opening))}",
            data: { turbo_frame: "opening_color_content", turbo_action: "advance" }, class: "opening-link" %>
          </div>
        </div>
        <div class="repertory-opening-card">
          <div class="repertory-card-top">
            <%= image_tag "pawn_bleu", alt: "icone ouverture blancs", class: "repertory-card-logo" %>
            <div class="repertory-card-title">
              <p> Avec les Noirs contre 1.e4 </p>
              <h5><%= @analysis["black_vs_e4"]["opening_recommended"] %></h5>
            </div>
          </div>
          <div class="repertory-opening-desc">
            <h3 class="opening-title">
            </h3>
            <p class="move-list">
              <%= @analysis["black_vs_e4"]["suite_de_coups"] %>
            </p>
            <%= link_to "", repertoire_black_vs_e4_path(@opening),
            # class: "link #{'active' if current_page?(white_opening_path(@opening)) || current_page?(opening_path(@opening))}",
            data: { turbo_frame: "opening_color_content", turbo_action: "advance" }, class: "opening-link" %>
          </div>
        </div>
      </section>
    </div>
  </div>
  <div class="opening-tab-view">
    <%= render "white" %>
  </div>
</div>
