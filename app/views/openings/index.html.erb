<% content_for(:page_title, "Tableau de bord") %>
<div class="dashboard">
  <div class="dash-top ">
      <div class="dash-profil">
        <div class="dash-profil-logo">
        </div>
        <div class="dash-profil-info">
          <p class="profil-info-title">Votre Profil</p>
          <h5>
            <%= @username %>
          </h5>
          <p>
             ELO - Chess.com
             <strong><%= @elo %></strong>
          </p>
          <div class="dash-profil-analyse row">
              <p>Parties analysées
                <strong>
                  <%= @games_count %>
                </strong>
              </p>
              <p>Mise à jour <strong><%= @last_update.strftime("%d %B %Y %H:%M") if @last_update.present? %></strong></p>
          </div>
        </div>
      </div>
      <div class="dash-stats">
        <div class="dash-stats-cards">
          <div class="stats-header">
            <p>Avec les Blancs</p>
            <h5 class="stat-blancs">
              <%= @winrate["white"] %>%
            </h5>
          </div>
          <div class="progress-container">
            <div class="progress-fill" style="width: 58%;">
            </div>
          </div>
        </div>
        <div class="dash-stats-cards">
          <div class="stats-header">
            <p>Avec les Noirs</p>
            <h5 class="stat-noirs">
              <%= @winrate["black"] %>%
            </h5>
          </div>
          <div class="progress-container">
            <div class="progress-fill" style="width: 41%;">
            </div>
          </div>
        </div>
      </div>
  </div>
  <div class="dash-bot">
    <div class="dash-bot-reco">
      <h3 class="reco-openings">Vos 3 ouvertures recommandées</h3>
      <p class="reco-text">Tenez-vous-en à ces trois ouvertures : une avec les Blancs, deux avec les Noirs. Ajoutez celles que vous voulez travailler à <a href="">mon répertoire</a>.</p>
    </div>
    <div class="dash-bot-cards">
      <div class="dash-opening-card">
        <div class="dash-card-top">
          <div class="dash-card-logo">♠</div>
          <div class="dash-card-side">Avec les blancs</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["white"]["opening_recommanded"] %>
          </h3>
          <p class="move-list">1. e4 e5 2. Cf3 Cc6 3. Fc4</p>
          <p class="opening-desc">
            <%= @analysis["white"]["reason"] %>
          </p>
        </div>
        <div class="dash-opening-whento">
          <h4>QUAND LA JOUER</h4>
          <p class="opening-desc">Joue cette ouverture quand tu joues les blancs.</p>
          <a href="" class="opening-link">Voir la fiche →</a>
        </div>
      </div>
      <div class="dash-opening-card">
        <div class="dash-card-top">
          <div class="dash-card-logo">♠</div>
          <div class="dash-card-side">Avec les noirs</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["black_vs_d4"]["opening_recommanded"] %>
          </h3>
          <p class="move-list">Liste de coups</p>
          <p class="opening-desc">
            <%= @analysis["black_vs_d4"]["reason"] %>
          </p>
        </div>
        <div class="dash-opening-whento">
          <h4>QUAND LA JOUER</h4>
          <p class="opening-desc">Quand ton adversaire joue d4.</p>
          <a href="" class="opening-link">Voir la fiche →</a>
        </div>
      </div>
      <div class="dash-opening-card">
        <div class="dash-card-top">
          <div class="dash-card-logo">♠</div>
          <div class="dash-card-side">Avec les noirs</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["black_vs_e4"]["opening"] %>
          </h3>
          <p class="move-list">Liste de coups</p>
          <p class="opening-desc">
            <%= @analysis["black_vs_e4"]["reason"] %>
          </p>
        </div>
        <div class="dash-opening-whento">
          <h4>QUAND LA JOUER</h4>
          <p class="opening-desc">
            Quand ton adversaire joue e4.
          </p>
          <a href="" class="opening-link">Voir la fiche →</a>
        </div>
      </div>
    </div>
  </div>
</div>
