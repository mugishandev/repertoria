<% content_for(:page_title, "Tableau de bord") %>
<div class="dashboard">
  <div class="dash-top ">
      <div class="dash-profil">
        <div class="dash-profil-logo">
          <%= image_tag "couronne-du-roi-bleu.png", alt: "avatar de l'utilisateur", class: "dash-profil-logo " %>
        </div>
        <div class="dash-profil-info">
          <p class="profil-info-title">Votre Profil</p>
          <h5>
            <%= @username %>
          </h5>
          <p>
             ELO - Chess.com
             <strong><%= @elo %></strong>
          </p>
          <div class="dash-profil-analyse">
              <p>Parties analysées
                <strong>
                  <%= @games_count %>
                </strong>
              </p>
              <p>Mise à jour <strong><%= @last_update.strftime("%d %b %Y") if @last_update.present? %></strong></p>
          </div>
        </div>
      </div>
      <div class="dash-stats">
        <p class="profil-info-title">Taux de victoires</p>
        <div class="dash-stats-cards">
          <div class="dash-stats-card">
            <div class="stats-header">
              <p>Avec les Blancs</p>
              <h5 class="stat-blancs">
                <%= @winrate["white"] %>%
              </h5>
            </div>
            <div class="progress-container">
              <div class="progress-fill" style="width: 58%;">
              </div>
            </div>
          </div>
          <div class="dash-stats-card">
            <div class="stats-header">
              <p>Avec les Noirs</p>
              <h5 class="stat-noirs">
                <%= @winrate["black"] %>%
              </h5>
            </div>
            <div class="progress-container">
              <div class="progress-fill" style="width: 41%;">
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
  <div class="dash-bot">
    <div class="dash-bot-reco">
      <h3 class="reco-openings">Vos 3 ouvertures recommandées</h3>
      <p class="reco-text">Tenez-vous-en à ces trois ouvertures : une avec les Blancs, deux avec les Noirs. Ajoutez celles que vous voulez travailler à <%= link_to "mon répertoire", repertoire_path %>.</p>
    </div>
    <div class="dash-bot-cards">

      <div class="dash-opening-card">
        <div class="dash-card-top">
          <%= image_tag "knight_bleu", alt: "icone ouverture blancs", class: "dash-card-logo" %>
          <div class="dash-card-side">Avec les Blancs</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["white"]["opening_recommended"] %>
          </h3>
          <p class="move-list">
             <%= @analysis["white"]["suite_de_coups"] %>
          </p>
          <p class="opening-desc">
            <%= @analysis["white"]["reason"] %>
          </p>
          <%= link_to "", opening_path(@analysis["white"]["opening_recommended_id"]), class: "opening-link" %>
        </div>
      </div>
      <div class="dash-opening-card">
        <div class="dash-card-top">
          <%= image_tag "pawn_bleu", alt: "icone ouverture noirs 1.d4", class: "dash-card-logo" %>
          <div class="dash-card-side">Avec les Noirs contre 1.d4</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["black_vs_d4"]["opening_recommended"] %>
          </h3>
          <p class="move-list">
            <%= @analysis["black_vs_d4"]["suite_de_coups"] %>
          </p>
          <p class="opening-desc">
            <%= @analysis["black_vs_d4"]["reason"] %>
          </p>
            <%= link_to "", opening_path(@analysis["black_vs_d4"]["opening_recommended_id"]), class: "opening-link" %>
        </div>
      </div>
      <div class="dash-opening-card">
        <div class="dash-card-top">
          <%= image_tag "pawn_bleu", alt: "icone ouverture noirs 1.d4", class: "dash-card-logo" %>
          <div class="dash-card-side">Avec les Noirs contre 1.e4</div>
        </div>
        <div class="dash-opening-desc">
          <h3 class="opening-title">
            <%= @analysis["black_vs_e4"]["opening_recommended"] %>
          </h3>
          <p class="move-list">
            <%= @analysis["black_vs_e4"]["suite_de_coups"] %>
          </p>
          <p class="opening-desc">
            <%= @analysis["black_vs_e4"]["reason"] %>
          </p>
            <%= link_to "", opening_path(@analysis["black_vs_e4"]["opening_recommended_id"]), class: "opening-link" %>
        </div>
      </div>
    </div>
  </div>
</div>
