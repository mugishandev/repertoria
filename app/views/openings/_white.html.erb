<%= turbo_frame_tag "opening_color_content" do %>

  <div class="repertory-analyse">
    <h2>Analyse de ton ouverture</h2>

    <div class="analyse-data">
      <div class="analyse-data-top">

        <div class="analyse-data-title">
          <h4>
            <%= @analysis[@analysis_key]["opening"] %>
          </h4>

          <p>Ton bilan avec cette ouverture</p>

          <h5 class="stats-winrate">
            <%= tag.span(
              "#{@opening_stats[:win_rate]}%",
              class: "stat-number #{winrate_color_class(@opening_stats[:win_rate], prefix: 'text--')}"
            ) %>

            <div class="progress-bar">
              <div
                class="progress <%= winrate_color_class(@opening_stats[:win_rate]) %>"
                style="width: <%= @opening_stats[:win_rate] %>%">
              </div>
            </div>
          </h5>
        </div>

        <div class="analyse-data-games">
          <p>
            <strong><%= @opening_stats[:count] %></strong> parties jouées
          </p>
        </div>

      </div>

      <div class="analyse-data-transcript">
        <h5>ton analyse</h5>

        <p>
          <%= @analysis[@analysis_key]["reason_detailed"] %>
        </p>
      </div>

    </div>
  </div>


  <div class="repertory-last-games">

    <div class="last-games-title">
      <h2>
        Tes dernières parties avec <%= @analysis[@analysis_key]["opening"] %>
      </h2>
    </div>

    <div class="last-games-cards">

      <% @last_games.each do |game| %>


        <% player_result =
          if game.dig("white", "username")&.downcase == @username&.downcase
            game.dig("white", "result")
          else
            game.dig("black", "result")
          end
        %>

        <div class="last-game-card">

          <div class="games-card-details">

            <h5>
              <%= game.dig("white", "username") %>
              vs
              <%= game.dig("black", "username") %>
            </h5>


            <p>
              <strong>
                <%= Game.result_fr(player_result) %>
              </strong>
            </p>

            <p>
              <%= link_to "Voir la partie",
                          game["url"],
                          target: "_blank",
                          rel: "noopener" %>
            </p>

          </div>

        </div>

      <% end %>

    </div>

  </div>

<% end %>
